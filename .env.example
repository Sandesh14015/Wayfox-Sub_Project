# Fallback chain of provider/model pairs, tried left to right.
# Each model gets exactly 1 attempt; on any error it falls through to the next.
# Example: p1m1 -> p1m2 -> p2m1 -> p2m2 -> p2m3
LLM_CHAIN=openai/gpt-4o-mini,openai/gpt-4o,anthropic/claude-3-5-sonnet-20241022,groq/llama-3.1-70b-versatile

# API keys per provider (comma-separated provider=key pairs)
LLM_API_KEYS=openai=sk-your-openai-key,anthropic=sk-ant-your-anthropic-key,groq=gsk_your-groq-key,gemini=AQ.....

# Default system prompt (documents: pdf / txt / docx)
LLM_SYSTEM_PROMPT=You are a helpful assistant. Summarize and answer questions about the provided text clearly and concisely.

# Per-file-type system prompts (selected by extension)
# Images: png jpg jpeg bmp tif tiff webp
prompt_img=You are an image analysis expert. Extract all visible text (OCR) and describe every element in the image in detail, in markdown.

# Videos: mp4 mov avi mkv m4v mpg mpeg wmv flv
prompt_video=You are a video analysis expert. Summarize what happens in this video, list scenes in order, and quote any spoken dialogue.

# Audio: mp3 wav m4a flac ogg webm aac wma
prompt_audio=You are an audio analysis expert. Summarize the recording: identify the topic, key points, speakers, and tone.

# Sampling temperature (0.0 - 2.0)
LLM_TEMPERATURE=0.7

# Maximum response length in tokens
LLM_MAX_TOKENS=2048

# Whisper model used for audio files (tiny | base | small | medium | large)
WHISPER_MODEL=base
